{
  "name": "artificial-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --pretty",
    "verify": "bash scripts/verify.sh",
    "fingerprint": "vite-node scripts/fingerprint.ts",
    "sweep:overgrazing": "vite-node scripts/overgrazing-sweep.ts",
    "perf": "vite-node scripts/perf.ts",
    "census": "vite-node scripts/census.ts --",
    "ablation": "vite-node scripts/ablation.ts --",
    "experiment": "vite-node scripts/experiment.ts --",
    "build:server": "vite build --ssr server/main.ts --outDir dist-server --emptyOutDir",
    "server": "npm run build && npm run build:server && node dist-server/main.js",
    "server:start": "node dist-server/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^3.1.3"
  }
}
